        "# Metrics available in the dropdown\n",
        "metrics = {\n",
        "    \"Parking Duration\": (\n",
        "        \"avg_parking_duration_minutes\",\n",
        "        \"Average Parking Duration (minutes)\"\n",
        "    ),\n",
        "    \"Parking Fee\": (\n",
        "        \"parking_fee_collected\",\n",
        "        \"Parking Fee Collected\"\n",
        "    ),\n",
        "    \"Occupancy Percentage\": (\n",
        "        \"occupancy_percentage\",\n",
        "        \"Occupancy (%)\"\n",
        "    ),\n",
        "    \"Entry Count\": (\n",
        "        \"entry_count\",\n",
        "        \"Entry Count\"\n",
        "    ),\n",
        "    \"Exit Count\": (\n",
        "        \"exit_count\",\n",
        "        \"Exit Count\"\n",
        "    )\n",
        "}\n",
        "\n",
        "# Create one trace for each zone so colors remain consistent\n",
        "zones = sorted(df[\"zone\"].unique())\n",
        "zone_frames = {\n",
        "    zone: df[df[\"zone\"] == zone].copy()\n",
        "    for zone in zones\n",
        "}\n",
        "\n",
        "fig6 = go.Figure()\n",
        "\n",
        "for zone in zones:\n",
        "    d = zone_frames[zone]\n",
        "\n",
        "    fig6.add_trace(go.Scatter(\n",
        "        x=d[\"occupied_slots\"],\n",
        "        y=d[\"avg_parking_duration_minutes\"],\n",
        "        mode=\"markers\",\n",
        "        name=str(zone),\n",
        "        marker=dict(size=7, opacity=0.7),\n",
        "        customdata=d[\n",
        "            [\"parking_id\", \"date_time\", \"occupancy_percentage\",\n",
        "             \"vehicle_type\"]\n",
        "        ].to_numpy(),\n",
        "        hovertemplate=(\n",
        "            \"<b>Parking ID:</b> %{customdata[0]}<br>\"\n",
        "            \"<b>Date:</b> %{customdata[1]}<br>\"\n",
        "            \"<b>Occupied Slots:</b> %{x}<br>\"\n",
        "            \"<b>Value:</b> %{y:.2f}<br>\"\n",
        "            \"<b>Occupancy:</b> %{customdata[2]:.2f}%<br>\"\n",
        "            \"<b>Vehicle:</b> %{customdata[3]}<extra></extra>\"\n",
        "        )\n",
        "    ))\n",
        "\n",
        "# Build dropdown buttons\n",
        "buttons = []\n",
        "\n",
        "for label, (column, axis_label) in metrics.items():\n",
        "\n",
        "    y_values = [\n",
        "        zone_frames[zone][column].tolist()\n",
        "        for zone in zones\n",
        "    ]\n",
        "\n",
        "    buttons.append(dict(\n",
        "        label=label,\n",
        "        method=\"update\",\n",
        "        args=[\n",
        "            {\"y\": y_values},\n",
        "            {\n",
        "                \"yaxis.title.text\": axis_label,\n",
        "                \"title.text\": f\"Occupied Slots vs {label}\"\n",
        "            }\n",
        "        ]\n",
        "    ))\n",
        "\n",
        "fig6.update_layout(\n",
        "    title=\"Occupied Slots vs Average Parking Duration\",\n",
        "    xaxis_title=\"Occupied Slots\",\n",
        "    yaxis_title=\"Average Parking Duration (minutes)\",\n",
        "    updatemenus=[\n",
        "        dict(\n",
        "            buttons=buttons,\n",
        "            direction=\"down\",\n",
        "            x=1,\n",
        "            xanchor=\"right\",\n",
        "            y=1.18,\n",
        "            yanchor=\"top\",\n",
        "            showactive=True\n",
        "        )\n",
        "    ],\n",
        "    annotations=[\n",
        "        dict(\n",
        "            text=\"Select Y-axis metric:\",\n",
        "            x=0.99,\n",
        "            xref=\"paper\",\n",
        "            y=1.25,\n",
        "            yref=\"paper\",\n",
        "            showarrow=False,\n",
        "            xanchor=\"right\"\n",
        "        )\n",
        "    ],\n",
        "    height=650\n",
        ")\n",
        "\n",
        "fig6.show()"
