      "source": [
        "# Use one frame per month, as in the reference's one-frame-per-year approach\n",
        "df_anim = df.copy()\n",
        "\n",
        "months = sorted(df_anim[\"month\"].unique())\n",
        "\n",
        "fig5 = px.scatter(\n",
        "    df_anim,\n",
        "    x=\"occupied_slots\",\n",
        "    y=\"avg_parking_duration_minutes\",\n",
        "    color=\"zone\",\n",
        "    size=\"parking_fee_collected\",\n",
        "    animation_frame=\"month\",\n",
        "    animation_group=\"parking_id\",\n",
        "    hover_name=\"parking_id\",\n",
        "    hover_data=[\n",
        "        \"date_time\",\n",
        "        \"total_slots\",\n",
        "        \"occupancy_percentage\",\n",
        "        \"vehicle_type\"\n",
        "    ],\n",
        "    category_orders={\"month\": months},\n",
        "    range_x=[\n",
        "        0,\n",
        "        max(1, float(df_anim[\"occupied_slots\"].max()) * 1.05)\n",
        "    ],\n",
        "    range_y=[\n",
        "        0,\n",
        "        max(1, float(df_anim[\"avg_parking_duration_minutes\"].max()) * 1.05)\n",
        "    ],\n",
        "    size_max=20,\n",
        "    opacity=0.7,\n",
        "    title=\"Monthly Parking Occupancy and Duration Animation\",\n",
        "    labels={\n",
        "        \"occupied_slots\": \"Occupied Slots\",\n",
        "        \"avg_parking_duration_minutes\": \"Average Parking Duration (minutes)\",\n",
        "        \"parking_fee_collected\": \"Parking Fee Collected\",\n",
        "        \"month\": \"Month\",\n",
        "        \"zone\": \"Parking Zone\"\n",
        "    }\n",
        ")\n",
        "\n",
        "fig5.update_layout(\n",
        "    height=650,\n",
        "    updatemenus=[dict(\n",
        "        type=\"buttons\",\n",
        "        buttons=[\n",
