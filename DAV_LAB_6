      "source": [
        "# Convert date_time into datetime format\n",
        "df[\"date_time\"] = pd.to_datetime(df[\"date_time\"], errors=\"coerce\")\n",
        "\n",
        "# Remove rows with invalid dates\n",
        "df = df.dropna(subset=[\"date_time\"]).copy()\n",
        "\n",
        "# Fill missing categorical values\n",
        "df[\"zone\"] = df[\"zone\"].fillna(\"Unknown\")\n",
        "df[\"vehicle_type\"] = df[\"vehicle_type\"].fillna(\"Unknown\")\n",
        "df[\"slot_status\"] = df[\"slot_status\"].fillna(\"Unknown\")\n",
        "\n",
        "# Fill missing numerical values with the respective column median\n",
        "numeric_cols = [\n",
        "    \"total_slots\", \"occupied_slots\",\n",
        "    \"avg_parking_duration_minutes\", \"entry_count\",\n",
        "    \"exit_count\", \"parking_fee_collected\",\n",
        "    \"busy_slots\", \"empty_slots\"\n",
        "]\n",
        "\n",
        "for col in numeric_cols:\n",
        "    df[col] = pd.to_numeric(df[col], errors=\"coerce\")\n",
        "    df[col] = df[col].fillna(df[col].median())\n",
        "\n",
        "# Create new analysis columns\n",
        "df[\"occupancy_percentage\"] = (\n",
        "    df[\"occupied_slots\"] / df[\"total_slots\"].replace(0, np.nan)\n",
        ") * 100\n",
        "\n",
        "df[\"occupancy_percentage\"] = df[\"occupancy_percentage\"].fillna(0)\n",
        "\n",
        "df[\"date\"] = df[\"date_time\"].dt.date\n",
        "df[\"year\"] = df[\"date_time\"].dt.year\n",
        "df[\"month\"] = df[\"date_time\"].dt.to_period(\"M\").astype(str)\n",
        "\n",
        "# Sort chronologically\n",
        "df = df.sort_values(\"date_time\").reset_index(drop=True)\n",
        "\n",
